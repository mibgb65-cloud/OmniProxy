# OmniProxy environment variables (example).
#
# Copy this file to .env for local development. .env is gitignored and must
# never contain real secrets. Values below are read from the process
# environment (see internal/platform/profile).

# Runtime profile: production | development | test
# Defaults to the build-tag profile: development for `wails3 dev` / `go run`,
# production for `wails3 build`. Dev and production data directories are
# strictly separated.
OMNIPROXY_PROFILE=development

# Log level: debug | info | warn | error
# Defaults to debug in development, info otherwise.
OMNIPROXY_LOG_LEVEL=debug

# Override the resolved data directory.
# Default: <OS config dir>/OmniProxy[-dev|-test]
# OMNIPROXY_DATA_DIR=

# Override the AI proxy port (default: 3000 production, 3001 development).
# OMNIPROXY_PROXY_PORT=

# Override the local Control API port (default: 3890 production, 3891 development).
# OMNIPROXY_CONTROL_PORT=
