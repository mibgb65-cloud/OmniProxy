# --- Build output ---
bin/
.task/
frontend/dist/*
!frontend/dist/.gitkeep
build/linux/appimage/build
build/windows/nsis/MicrosoftEdgeWebview2Setup.exe

# --- Dependencies ---
frontend/node_modules/

# --- Mobile generated (per-machine; overlays hold absolute paths) ---
build/ios/xcode/overlay.json
build/ios/xcode/gen/
build/android/overlay.json
build/android/gen/

# --- Environment & secrets ---
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.cer
# 只允许项目公开签名证书；私钥与 PFX 始终忽略。
!build/windows/codesign.cer
# 凭据数据文件才需要忽略。此前用宽泛的 `credentials*` / `secrets*`，会把
# `internal/provider/*/credentials.go` 这类源码一起忽略：v2.3.0 因此漏提交过 DuMate
# 凭据类型，v2.4.0 又漏了 WorkBuddy AI 的，托管构建直接 undefined: Credentials。
# 改为按数据文件后缀匹配，源码文件不再被误伤。
credentials*.json
credentials*.yaml
credentials*.yml
credentials*.txt
credentials*.db
credentials*.sqlite
secrets*.json
secrets*.yaml
secrets*.yml
secrets*.txt

# --- Logs & local data ---
*.log
logs/
!frontend/src/features/logs/
!frontend/src/features/logs/**
coverage/
omniproxy.db
omniproxy.db-wal
omniproxy.db-shm

# --- Editor / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- Temp ---
tmp/
temp/
*.syso
release-assets/
