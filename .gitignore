# --- Build output ---
bin/
.task/
frontend/dist/*
!frontend/dist/.gitkeep
build/linux/appimage/build
build/windows/nsis/MicrosoftEdgeWebview2Setup.exe

# --- Dependencies ---
frontend/node_modules/

# --- Mobile generated (per-machine; overlays hold absolute paths) ---
build/ios/xcode/overlay.json
build/ios/xcode/gen/
build/android/overlay.json
build/android/gen/

# --- Environment & secrets ---
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.cer
# 只允许项目公开签名证书；私钥与 PFX 始终忽略。
!build/windows/codesign.cer
credentials*
secrets*

# --- Logs & local data ---
*.log
logs/
!frontend/src/features/logs/
!frontend/src/features/logs/**
coverage/
omniproxy.db
omniproxy.db-wal
omniproxy.db-shm

# --- Editor / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- Temp ---
tmp/
temp/
*.syso
release-assets/
